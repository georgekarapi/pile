{
  "expo": {
    "name": "Pile",
    "slug": "pile",
    "scheme": "pile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.pile.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.pile.app"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pile.app",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
