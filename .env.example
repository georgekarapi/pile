EXPO_PUBLIC_IDENTITY_PRIVACY_URL=https://example.com/privacy

# ==========================================
# 2. FIREBASE & CORE PRODUCT CONFIG
# ==========================================
FIREBASE_PROJECT_ID=your-project-id
PILE_MODE=demo
PILE_TREASURY_ENABLED=false
PILE_DEMO_GLOBAL_CAP_USD=500
PILE_DEMO_WALLET_CAP_USD=50
PILE_ALLOWED_ORIGINS=https://admin.example.com
PILE_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ==========================================
# 3. PLAN OPTIONS & BASKETS
# ==========================================
# Note: Plan options, token mints, symbols, and percentage weights are stored
# dynamically in Firestore (collection: plan_options) and served via /v1/plans/options.
# No hardcoded token mints required in environment variables.

# ==========================================
# 4. PROVIDER KEYS
# ==========================================
# Stripe Sandbox
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PILE_STRIPE_PRODUCT_ID=prod_...
PILE_STRIPE_PORTAL_CONFIGURATION_ID=

# Privy Authentication
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=

# Solana Devnet RPC & DeFi Protocols (Optional)
HELIUS_RPC_URL=
JUPITER_API_KEY=
KAMINO_MARKET_ADDRESS=
